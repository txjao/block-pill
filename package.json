{
  "name": "block-pill",
  "version": "0.1.0",
  "description": "Uma extensão de navegador privada para reduzir distrações digitais.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && node scripts/validate-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txjao/block-pill.git"
  },
  "keywords": [
    "browser-extension",
    "focus",
    "privacy"
  ],
  "author": "txjao",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/txjao/block-pill/issues"
  },
  "homepage": "https://github.com/txjao/block-pill#readme",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
